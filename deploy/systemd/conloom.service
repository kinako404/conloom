[Unit]
Description=ConLoom core service
Documentation=https://github.com/kinako404/conloom
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=conloom
Group=conloom
WorkingDirectory=/opt/conloom
ExecStart=/opt/conloom/conloom serve -c /opt/conloom/conloom.yaml
Restart=always
RestartSec=3
# Exit status 2 is a configuration error (invalid config) that a restart
# cannot fix. A Go panic also exits with 2.
RestartPreventExitStatus=2
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# storage.data_dir must be writable and must exist before the service starts.
ReadWritePaths=/opt/conloom/data

[Install]
WantedBy=multi-user.target
