[Unit]
Description=ConLoom core service
Documentation=https://github.com/kinako404/conloom
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=conloom
Group=conloom
WorkingDirectory=/opt/conloom
ExecStart=/opt/conloom/conloom serve -c /opt/conloom/conloom.yaml
Restart=always
RestartSec=3
# Exit status 78 (EX_CONFIG) is a configuration error (invalid config) that a
# restart cannot fix. Crashes, including Go panics (status 2), are restarted.
RestartPreventExitStatus=78
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# storage.data_dir must be writable and must exist before the service starts.
ReadWritePaths=/opt/conloom/data

[Install]
WantedBy=multi-user.target
