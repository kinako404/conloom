[Unit]
Description=ConLoom NapCat adapter
Documentation=https://github.com/kinako404/conloom
After=network-online.target conloom.service
Wants=network-online.target conloom.service

[Service]
Type=simple
User=conloom
Group=conloom
WorkingDirectory=/opt/conloom
ExecStart=/opt/conloom/conloom adapter napcat -c /opt/conloom/conloom.yaml
Restart=always
RestartSec=3
# Exit status 78 (EX_CONFIG) is a configuration error (invalid config) that a
# restart cannot fix. Crashes, including Go panics (status 2), are restarted.
RestartPreventExitStatus=78
# Shutdown can wait up to about 70s for an in-flight send and its ACK.
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# adapters.napcat.state_dir (default: storage.data_dir) must be writable and
# must exist before the service starts.
ReadWritePaths=/opt/conloom/data

[Install]
WantedBy=multi-user.target
